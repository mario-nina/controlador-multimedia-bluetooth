# EditorConfig: https://editorconfig.org
root = true

# Reglas globales para todos los archivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Archivos C y headers
[*.{c,h}]
indent_style = space
indent_size = 4

# Archivos de configuración ESP-IDF
[*.{cmake,cmake.in}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

# Archivos Markdown y LaTeX
[*.{md,tex}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Archivos de configuración
[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

# Makefile requiere tabs obligatoriamente
[Makefile]
indent_style = tab
indent_size = 4

# Archivos de script
[*.sh]
indent_style = space
indent_size = 2
